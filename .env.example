# Use a generated alphanumeric password (avoid URI-reserved characters).
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password
# Local compose only binds localhost. Set oidc before any shared hosting.
AUTH_MODE=local
ALLOWED_EMAILS=business@unseenrobotics.com,urit@unseenrobotics.com
# For running outside compose:
# DATABASE_URL=postgresql+psycopg://crm:password@localhost:5432/crm
